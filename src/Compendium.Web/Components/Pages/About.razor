            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">License</h5>
                </div>
                <div class="card-body">
                    <p class="small mb-0">
                        Compendium is open source software.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
