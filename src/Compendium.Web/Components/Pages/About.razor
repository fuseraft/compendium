                        <a href="/docs/DataMaps.md" class="btn btn-outline-info btn-sm">
                            📊 Data Maps Documentation
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Getting Started</h5>
                </div>
                <div class="card-body">
                    <ol class="mb-0">
                        <li><a href="/load-bundle">Load a bundle</a></li>
