@page "/chat"
@rendermode InteractiveServer
@using Compendium.Agent
@using Microsoft.Extensions.AI
@using Markdig
@using Microsoft.JSInterop
@inject Services.BundleService BundleService
@inject Services.LlmConfigService LlmConfigService
@inject IJSRuntime JSRuntime

<PageTitle>Chat - Compendium</PageTitle>

<div class="container-fluid h-100 d-flex flex-column">
    <div class="row mt-3">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1>Chat with Compendium Agent</h1>
                @if (messages.Count > 0)
                {
                    <div class="btn-group">
                        <button class="btn btn-outline-primary btn-sm" @onclick="SaveTranscript" title="Save transcript to file">
                            <span>💾 Save Transcript</span>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearChat" title="Clear chat history">
                            <span>🗑️ Clear</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (BundleService.CurrentBundle == null)
    {
        <div class="row">
            <div class="col">
                <div class="alert alert-warning">
                    <h5 class="alert-heading">No Bundle Loaded</h5>
                    <p>You need to load a knowledge bundle before using the chat.</p>
                    <hr>
                    <a href="/load-bundle" class="btn btn-primary">Load Bundle</a>
                </div>
            </div>
        </div>
    }
    else if (agent == null)
    {
        <div class="row">
            <div class="col">
                <div class="alert alert-warning">
                    <h5 class="alert-heading">LLM Not Configured</h5>
                    <p>You need to configure your language model provider before using the chat.</p>
                    <hr>
                    <a href="/settings" class="btn btn-primary">Configure LLM</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row flex-grow-1 overflow-hidden">
            <div class="col">
                <div class="card h-100 d-flex flex-column">
                    <div class="card-body flex-grow-1 overflow-auto" id="chatMessages" style="max-height: calc(100vh - 250px);">
                        @if (messages.Count == 0)
                        {
                            <div class="text-center text-muted mt-5">
                                <p>Ask me anything about the knowledge catalog.</p>
                                <p class="small">I can list concepts, search, and answer questions based on the loaded bundle.</p>
                            </div>
                        }
                    else
                    {
                        @foreach (var msg in messages)
                        {
                            <div class="mb-3 @(msg.Role == "user" ? "text-end" : "")">
                                <div class="d-inline-block text-start" style="max-width: 80%;">
                                    <div class="p-3 rounded @(msg.Role == "user" ? "bg-primary text-white" : "bg-light") @(msg.Role != "user" ? "markdown-content" : "")">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <strong>@(msg.Role == "user" ? "You" : "Agent"):</strong>
                                            <button class="btn btn-sm @(msg.Role == "user" ? "btn-outline-light" : "btn-outline-secondary") ms-2"
                                                    style="padding: 0.1rem 0.4rem; font-size: 0.75rem;"
                                                    @onclick="() => CopyMessage(msg.Text)"
                                                    title="Copy message">
                                                📋
                                            </button>
                                        </div>
                                        <div class="mt-1">
                                            @if (msg.Role == "user")
                                            {
                                                @msg.Text
                                            }
                                            else
                                            {
                                                @((MarkupString)RenderMarkdown(msg.Text))
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (isProcessing)
                        {
                            <div class="mb-3">
                                <div class="d-inline-block p-3 rounded bg-light" style="max-width: 80%;">
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">Processing...</span>
                                    </div>
                                    <span class="ms-2">Thinking...</span>
                                </div>
                            </div>
                        }
                        }
                    </div>
                    <div class="card-footer">
                        <div class="input-group">
                            <textarea class="form-control" placeholder="Ask a question... (Press Enter to send, Shift+Enter for new line)"
                                   rows="2"
                                   @bind="userInput"
                                   @bind:event="oninput"
                                   @onkeydown="HandleKeyPress"
                                   @onkeydown:preventDefault="preventKeyDefault"
                                   disabled="@isProcessing"></textarea>
                            <button class="btn btn-primary" @onclick="SendMessage" disabled="@(isProcessing || string.IsNullOrWhiteSpace(userInput))">
                                Send
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ChatMessage> messages = new();
    private string userInput = "";
    private bool isProcessing = false;
    private bool preventKeyDefault = false;
    private Microsoft.Agents.AI.AIAgent? agent;
    private Microsoft.Agents.AI.AgentSession? session;

    protected override async Task OnInitializedAsync()
    {
        if (BundleService.CurrentBundle == null)
            return;

        if (LlmConfigService.IsConfigured)
        {
            var settings = new AgentSettings
            {
                BaseUrl = LlmConfigService.BaseUrl!,
                ApiKey = LlmConfigService.ApiKey!,
                Model = LlmConfigService.ModelName!
            };
            var tools = new CompendiumTools(BundleService.CurrentBundle);
            agent = CompendiumAgentFactory.Create(settings, tools, allowWrite: false);
            session = await agent.CreateSessionAsync();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || agent == null || session == null)
            return;

        var question = userInput;
        userInput = "";

        messages.Add(new ChatMessage("user", question));
        isProcessing = true;
        StateHasChanged();

        try
        {
            var response = await agent.RunAsync(question, session);
            messages.Add(new ChatMessage("assistant", response.Text));
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessage("assistant", $"Error: {ex.Message}"));
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        // Enter without modifiers = send message
        if (e.Key == "Enter" && !e.ShiftKey && !e.CtrlKey && !e.AltKey && !isProcessing)
        {
            preventKeyDefault = true;
            await SendMessage();
        }
        else
        {
            preventKeyDefault = false;
        }
    }

    private string RenderMarkdown(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
        return Markdig.Markdown.ToHtml(markdown, pipeline);
    }

    private async Task CopyMessage(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception)
        {
            // Clipboard API might not be available in all contexts
        }
    }

    private async Task SaveTranscript()
    {
        var transcript = new System.Text.StringBuilder();
        transcript.AppendLine("# Compendium Chat Transcript");
        transcript.AppendLine($"Generated: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
        transcript.AppendLine($"Bundle: {BundleService.BundlePath}");
        transcript.AppendLine();
        transcript.AppendLine("---");
        transcript.AppendLine();

        foreach (var msg in messages)
        {
            transcript.AppendLine($"## {(msg.Role == "user" ? "You" : "Agent")}");
            transcript.AppendLine();
            transcript.AppendLine(msg.Text);
            transcript.AppendLine();
        }

        var content = transcript.ToString();
        var fileName = $"chat-transcript-{DateTime.Now:yyyyMMdd-HHmmss}.md";

        // Use JavaScript to trigger download
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, content);
    }

    private async Task ClearChat()
    {
        messages.Clear();

        // Reset the agent session to clear conversation history
        if (agent != null)
        {
            session = await agent.CreateSessionAsync();
        }

        StateHasChanged();
    }

    private record ChatMessage(string Role, string Text);
}
