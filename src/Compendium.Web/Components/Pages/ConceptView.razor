@page "/concept/{*ConceptId}"
@rendermode InteractiveServer
@using Compendium.Okf
@using Markdig
@inject Services.BundleService BundleService
@inject NavigationManager Navigation

<PageTitle>@(concept?.Title ?? "Concept") - Compendium</PageTitle>

<div class="container mt-4">
    @if (concept == null)
    {
        <div class="alert alert-danger">
            Concept not found
        </div>
        <a href="/" class="btn btn-secondary">Back to Catalog</a>
    }
    else
    {
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Catalog</a></li>
                <li class="breadcrumb-item active">@concept.Title</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1>@concept.Title</h1>
                <p class="lead text-muted">@concept.Description</p>
            </div>
            <div>
                <span class="badge bg-primary fs-6">@concept.Type</span>
                <span class="badge @GetStatusBadgeClass(concept.Status) fs-6 ms-2">@concept.Status</span>
            </div>
        </div>

        @if (concept.Frontmatter.TryGetValue("tags", out var tagsObj) && tagsObj is System.Collections.IEnumerable tags)
        {
            <div class="mb-3">
                @foreach (var tag in tags)
                {
                    <span class="badge bg-secondary me-1">@tag</span>
                }
            </div>
        }

        <div class="card mb-4">
            <div class="card-body markdown-content">
                @((MarkupString)RenderMarkdown(concept.Body))
            </div>
        </div>

        @if (concept.Frontmatter.TryGetValue("sources", out var sourcesObj) && sourcesObj != null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Sources</h5>
                </div>
                <div class="card-body">
                    @RenderFrontmatterValue(sourcesObj)
                </div>
            </div>
        }

        @if (concept.Frontmatter.TryGetValue("generated", out var genObj) && genObj != null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Generation Info</h5>
                </div>
                <div class="card-body">
                    @RenderFrontmatterValue(genObj)
                </div>
            </div>
        }

        @if (concept.Status.Equals("draft", StringComparison.OrdinalIgnoreCase))
        {
            <div class="card mb-4 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">⚠️ Draft Concept - Review Required</h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">This concept was created by an agent and needs human review before it can be marked as stable.</p>
                    <div class="btn-group me-2">
                        <button class="btn btn-success" @onclick="() => MarkAsStable()" disabled="@isProcessing">
                            ✓ Approve & Mark Stable
                        </button>
                        <button class="btn btn-danger" @onclick="() => DeleteConcept()" disabled="@isProcessing">
                            ✗ Reject & Delete
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger") mt-3 mb-0">
                            @statusMessage
                        </div>
                    }
                </div>
            </div>
        }

        <div class="mb-4">
            <a href="/" class="btn btn-secondary">Back to Catalog</a>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? ConceptId { get; set; }

    private Concept? concept;
    private bool isProcessing = false;
    private string? statusMessage = null;
    private bool statusSuccess = false;

    protected override void OnInitialized()
    {
        if (BundleService.CurrentBundle != null && ConceptId != null)
        {
            BundleService.CurrentBundle.Concepts.TryGetValue(ConceptId, out concept);
        }
    }

    private void MarkAsStable()
    {
        if (concept == null || BundleService.BundlePath == null) return;

        isProcessing = true;
        statusMessage = null;
        StateHasChanged();

        try
        {
            var result = Compendium.Okf.ConceptWriter.UpdateStatus(
                BundleService.BundlePath,
                concept.Id,
                "stable",
                "user:web-ui",
                DateTime.UtcNow);

            statusSuccess = result.Success;
            statusMessage = result.Message;

            if (result.Success)
            {
                BundleService.ReloadBundle();
                // Reload the concept from the reloaded bundle
                if (BundleService.CurrentBundle != null && ConceptId != null)
                {
                    BundleService.CurrentBundle.Concepts.TryGetValue(ConceptId, out concept);
                }
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void DeleteConcept()
    {
        if (concept == null || BundleService.BundlePath == null) return;

        isProcessing = true;
        statusMessage = null;
        StateHasChanged();

        try
        {
            var result = Compendium.Okf.ConceptWriter.Delete(
                BundleService.BundlePath,
                concept.Id,
                "user:web-ui",
                DateTime.UtcNow);

            statusSuccess = result.Success;
            statusMessage = result.Message;

            if (result.Success)
            {
                // Redirect to home after successful deletion
                System.Threading.Tasks.Task.Delay(1500).ContinueWith(_ =>
                {
                    Navigation.NavigateTo("/");
                });
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private string GetStatusBadgeClass(string status) => status.ToLower() switch
    {
        "stable" => "bg-success",
        "draft" => "bg-warning",
        _ => "bg-secondary"
    };

    private string RenderMarkdown(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
        return Markdig.Markdown.ToHtml(markdown, pipeline);
    }

    private RenderFragment RenderFrontmatterValue(object? value)
    {
        return builder =>
        {
            if (value == null)
            {
                builder.AddContent(0, "N/A");
                return;
            }

            // Handle dictionary (like { by: "...", at: "..." })
            if (value is IDictionary<object, object> dict)
            {
                builder.OpenElement(1, "dl");
                builder.AddAttribute(2, "class", "row mb-0");
                int seq = 3;
                foreach (var kvp in dict)
                {
                    builder.OpenElement(seq++, "dt");
                    builder.AddAttribute(seq++, "class", "col-sm-3");
                    builder.AddContent(seq++, kvp.Key?.ToString() ?? "");
                    builder.CloseElement();

                    builder.OpenElement(seq++, "dd");
                    builder.AddAttribute(seq++, "class", "col-sm-9");
                    builder.AddContent(seq++, kvp.Value?.ToString() ?? "N/A");
                    builder.CloseElement();
                }
                builder.CloseElement();
            }
            // Handle list of dictionaries (like sources with id, resource, title)
            else if (value is System.Collections.IList list && list.Count > 0 && list[0] is IDictionary<object, object>)
            {
                builder.OpenElement(10, "ul");
                builder.AddAttribute(11, "class", "list-unstyled mb-0");
                int seq = 12;
                foreach (var item in list)
                {
                    if (item is IDictionary<object, object> itemDict)
                    {
                        builder.OpenElement(seq++, "li");
                        builder.AddAttribute(seq++, "class", "mb-3");

                        builder.OpenElement(seq++, "dl");
                        builder.AddAttribute(seq++, "class", "row mb-0");
                        foreach (var kvp in itemDict)
                        {
                            builder.OpenElement(seq++, "dt");
                            builder.AddAttribute(seq++, "class", "col-sm-3");
                            builder.AddContent(seq++, kvp.Key?.ToString() ?? "");
                            builder.CloseElement();

                            builder.OpenElement(seq++, "dd");
                            builder.AddAttribute(seq++, "class", "col-sm-9");

                            // Special handling for URLs
                            var valueStr = kvp.Value?.ToString() ?? "";
                            if (kvp.Key?.ToString()?.ToLower() == "resource" && Uri.TryCreate(valueStr, UriKind.Absolute, out var uri))
                            {
                                builder.OpenElement(seq++, "a");
                                builder.AddAttribute(seq++, "href", valueStr);
                                builder.AddAttribute(seq++, "target", "_blank");
                                builder.AddAttribute(seq++, "rel", "noopener noreferrer");
                                builder.AddContent(seq++, valueStr);
                                builder.CloseElement();
                            }
                            else
                            {
                                builder.AddContent(seq++, valueStr);
                            }

                            builder.CloseElement();
                        }
                        builder.CloseElement();
                        builder.CloseElement();
                    }
                }
                builder.CloseElement();
            }
            // Handle simple list
            else if (value is IEnumerable<object> enumerable)
            {
                builder.OpenElement(20, "ul");
                builder.AddAttribute(21, "class", "list-unstyled mb-0");
                int seq = 22;
                foreach (var item in enumerable)
                {
                    builder.OpenElement(seq++, "li");
                    builder.AddContent(seq++, item?.ToString() ?? "");
                    builder.CloseElement();
                }
                builder.CloseElement();
            }
            // Handle simple value
            else
            {
                builder.AddContent(30, value.ToString() ?? "");
            }
        };
    }
}
