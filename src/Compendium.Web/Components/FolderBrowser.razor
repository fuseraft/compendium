@using System.IO

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Browse Folders</h6>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Close">✕</button>
    </div>
    <div class="card-body">
        <!-- Quick Access -->
        <div class="mb-3">
            <small class="text-muted">Quick Access:</small>
            <div class="btn-group-vertical w-100 mt-1">
                <button class="btn btn-sm btn-outline-secondary text-start" @onclick="() => NavigateTo(GetUserProfile())">
                    📁 User Profile
                </button>
                <button class="btn btn-sm btn-outline-secondary text-start" @onclick="() => NavigateTo(GetDocuments())">
                    📄 Documents
                </button>
                <button class="btn btn-sm btn-outline-secondary text-start" @onclick="() => NavigateTo(GetDesktop())">
                    🖥️ Desktop
                </button>
                @if (OperatingSystem.IsWindows())
                {
                    <button class="btn btn-sm btn-outline-secondary text-start" @onclick="NavigateToCDrive">
                        💾 C:\ Drive
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary text-start" @onclick="NavigateToRoot">
                        💾 Root
                    </button>
                }
            </div>
        </div>

        <hr>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                @foreach (var (segment, path) in GetBreadcrumbs())
                {
                    <li class="breadcrumb-item">
                        <a href="#" @onclick="() => NavigateTo(path)" @onclick:preventDefault>@segment</a>
                    </li>
                }
            </ol>
        </nav>

        <!-- Current Path -->
        <div class="mb-2">
            <small class="text-muted">Current Path:</small>
            <div class="input-group input-group-sm">
                <input type="text" class="form-control" @bind="currentPath" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" @onclick="() => NavigateTo(currentPath)">Go</button>
            </div>
        </div>

        <!-- Folder List -->
        <div class="list-group" style="max-height: 300px; overflow-y: auto;">
            @if (!string.IsNullOrEmpty(parentPath))
            {
                <button class="list-group-item list-group-item-action" @onclick="NavigateUp">
                    📁 <strong>..</strong> (Parent Directory)
                </button>
            }
            @if (directories.Count == 0 && !string.IsNullOrEmpty(errorMessage))
            {
                <div class="list-group-item text-danger">
                    @errorMessage
                </div>
            }
            @foreach (var dir in directories)
            {
                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                        @onclick="() => NavigateTo(dir.FullName)">
                    <span>📁 @dir.Name</span>
                    <small class="text-muted">@GetSubfolderCount(dir) folders</small>
                </button>
            }
            @if (directories.Count == 0 && string.IsNullOrEmpty(errorMessage))
            {
                <div class="list-group-item text-muted">
                    <em>No subdirectories</em>
                </div>
            }
        </div>

        <!-- Select Button -->
        <div class="mt-3">
            <button class="btn btn-primary w-100" @onclick="SelectCurrent">
                Select This Folder
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<string> OnFolderSelected { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    private string currentPath = "";
    private string? parentPath = null;
    private List<DirectoryInfo> directories = new();
    private string? errorMessage = null;

    protected override void OnInitialized()
    {
        currentPath = GetUserProfile();
        NavigateTo(currentPath);
    }

    private void NavigateTo(string path)
    {
        try
        {
            errorMessage = null;
            var dirInfo = new DirectoryInfo(path);

            if (!dirInfo.Exists)
            {
                errorMessage = "Directory does not exist or is inaccessible";
                return;
            }

            currentPath = dirInfo.FullName;
            parentPath = dirInfo.Parent?.FullName;

            // Get subdirectories
            directories = dirInfo.GetDirectories()
                .Where(d => !d.Attributes.HasFlag(FileAttributes.System) &&
                           !d.Attributes.HasFlag(FileAttributes.Hidden))
                .OrderBy(d => d.Name)
                .ToList();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Access denied to this directory";
            directories.Clear();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            directories.Clear();
        }
    }

    private void NavigateUp()
    {
        if (!string.IsNullOrEmpty(parentPath))
        {
            NavigateTo(parentPath);
        }
    }

    private List<(string Segment, string Path)> GetBreadcrumbs()
    {
        var breadcrumbs = new List<(string, string)>();
        if (string.IsNullOrEmpty(currentPath))
            return breadcrumbs;

        var parts = currentPath.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var accumulated = "";

        foreach (var part in parts)
        {
            if (string.IsNullOrEmpty(part))
                continue;

            if (string.IsNullOrEmpty(accumulated))
            {
                if (OperatingSystem.IsWindows())
                    accumulated = part + Path.DirectorySeparatorChar;
                else
                    accumulated = Path.DirectorySeparatorChar + part;
            }
            else
            {
                accumulated = Path.Combine(accumulated, part);
            }

            breadcrumbs.Add((part, accumulated));
        }

        return breadcrumbs;
    }

    private int GetSubfolderCount(DirectoryInfo dir)
    {
        try
        {
            return dir.GetDirectories().Length;
        }
        catch
        {
            return 0;
        }
    }

    private async Task SelectCurrent()
    {
        await OnFolderSelected.InvokeAsync(currentPath);
    }

    private async Task Close()
    {
        await OnClosed.InvokeAsync();
    }

    private void NavigateToCDrive() => NavigateTo("C:\\");
    private void NavigateToRoot() => NavigateTo("/");

    private string GetUserProfile() => Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
    private string GetDocuments() => Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
    private string GetDesktop() => Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
}
